# Copy to .env at the repo root (API) and fill in. Never commit real values.

# App
APP_ENV=local
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
SUPABASE_JWT_SECRET=              # legacy HS256 secret; leave empty to verify via JWKS
SUPABASE_DB_URL=                  # only used by scripts/apply_migrations.py

# Secrets storage
SECRET_STORE=aesgcm               # aesgcm | vault
TOKEN_ENCRYPTION_KEY=             # 32 bytes, base64; required for aesgcm
OAUTH_STATE_SECRET=               # HMAC key for signing OAuth state

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_TOOL_STEPS=8
MAX_TOOLS_PER_REQUEST=24
CHAT_RATE_LIMIT_PER_MINUTE=20      # per user, /api/chat and approval decisions
APPROVAL_TTL_HOURS=24

# API versions (not credentials)
NOTION_VERSION=2026-03-11         # Notion-Version header (verified 2026-11-11)
META_GRAPH_VERSION=               # VERIFY latest in Meta docs (Phase 4)
GOOGLE_ADS_API_VERSION=           # VERIFY latest in Google Ads docs (Phase 4)

# Provider app credentials are entered by each user on the Connections page and
# stored encrypted in provider_apps. OPTIONAL platform defaults, used only when a
# user has not set up their own app: PLATFORM_<APP>_<FIELD>
# PLATFORM_GOOGLE_CLIENT_ID=
# PLATFORM_GOOGLE_CLIENT_SECRET=
# PLATFORM_SLACK_CLIENT_ID=
# PLATFORM_SLACK_CLIENT_SECRET=
# PLATFORM_NOTION_CLIENT_ID=
# PLATFORM_NOTION_CLIENT_SECRET=
# PLATFORM_GITHUB_CLIENT_ID=
# PLATFORM_GITHUB_CLIENT_SECRET=
# PLATFORM_GITHUB_APP_SLUG=

# Safety
ALLOW_PRIVATE_DB_HOSTS=false      # Postgres connector SSRF guard

# --- Web app: apps/web/.env.local (public values only) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
